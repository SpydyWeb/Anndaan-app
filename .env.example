# ---- Copy to .env on the server and fill in. Never commit .env. ----

# Domains (point both DNS A records at the VPS before starting)
API_DOMAIN=api.example.in
ADMIN_DOMAIN=admin.example.in
ACME_EMAIL=ops@example.in

# Database (generate: openssl rand -base64 32)
POSTGRES_DB=annadaan
POSTGRES_USER=annadaan
POSTGRES_PASSWORD=

# Auth (generate: openssl rand -hex 48). Rotating it signs everyone out.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# OTP / SMS. Production refuses to start with OTP_DEV_MODE=true or SMS_PROVIDER=console.
OTP_DEV_MODE=false
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Optional DLT-approved Flow template for "NGO verified / needs changes" SMS
MSG91_FLOW_TEMPLATE_ID=

# Expo push (optional; only if "Enhanced push security" is enabled in your Expo project)
EXPO_ACCESS_TOKEN=

# HTTP
CORS_ORIGINS=https://admin.example.in
RATE_LIMIT_PER_MINUTE=120

# Off-site backups via rclone (example: Backblaze B2). Leave TYPE empty to disable.
OFFSITE_BUCKET=annadaan-backups
RCLONE_CONFIG_OFFSITE_TYPE=b2
RCLONE_CONFIG_OFFSITE_ACCOUNT=
RCLONE_CONFIG_OFFSITE_KEY=
# For Cloudflare R2 instead:
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
BACKUP_KEEP_DAYS=7
OFFSITE_KEEP_DAYS=30
